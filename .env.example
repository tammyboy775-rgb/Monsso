# Replace each placeholder with the exact Wallet Address URL from its test-wallet account.
OP_CLIENT_WALLET_ADDRESS=replace-with-exact-client-wallet-address
OP_MERCHANT_WALLET_ADDRESS=replace-with-exact-merchant-wallet-address
OP_PRIVATE_KEY_PATH=C:\Users\YOUR_NAME\Downloads\private.key
# On Vercel, set OP_PRIVATE_KEY to the PEM contents instead of using OP_PRIVATE_KEY_PATH.
OP_KEY_ID=replace-with-test-wallet-key-id
MONSSO_APP_ORIGIN=http://localhost:5173
VITE_GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
